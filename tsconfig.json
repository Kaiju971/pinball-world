{
  "compilerOptions": {
    "resolveJsonModule": true, // ✅ Permet d'importer des .json
    "jsx": "react",
    "target": "ES2020",
    "module": "ESNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
